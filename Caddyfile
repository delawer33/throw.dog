# throw.dog — Caddy только терминирует TLS и проксирует.
# Статику отдаёт само приложение.
{
	# Админ-API наружу не нужен.
	admin off
	# ACME не используется: сертификат выдан Cloudflare Origin CA.
	auto_https disable_redirects
}

{$SITE_DOMAIN} {
	# Security headers. They are identical for every response and must not
	# depend on application code, so they live here — with one exception:
	# Content-Security-Policy is set by the app, because it names each inline
	# script by hash and only the app knows those. Never set a CSP here too:
	# two policies intersect, and the intersection is a blank page.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# A closed-throw link carries the key in its fragment. no-referrer so
		# no click out of that page can hand the URL to anyone.
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Redundant with frame-ancestors 'none' in the CSP; kept for browsers
		# that only understand this one.
		X-Frame-Options "DENY"
		# Caddy need not announce itself — and reverse_proxy's own
		# `Via: 1.1 Caddy` names the same stack, so it goes too.
		-Server
		-Via
	}

	# Сертификат Cloudflare Origin CA, смонтирован из ./certs read-only.
	# Cloudflare должен быть в режиме Full (strict) — открытого HTTP
	# между CDN и ориджином быть не должно.
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	log {
		output stdout
		format console
	}

	reverse_proxy app:{$APP_PORT} {
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 60s
			write_timeout 60s
		}
		header_up X-Real-IP {remote_host}
	}
}

# Аналитика (self-hosted Umami) на поддомене. Тот же сертификат Origin CA —
# он выписан на *.throw.dog, поэтому поддомен покрыт. Наружу только Caddy;
# сам Umami слушает внутри docker-сети на 3000.
{$ANALYTICS_DOMAIN} {
	# Umami is a third-party app with its own dashboard: harden the transport
	# and the frame, but do not police its scripts — a strict CSP here would
	# blank the dashboard and buy nothing (no key ever touches this host).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
		-Via
	}

	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	log {
		output stdout
		format console
	}

	reverse_proxy umami:3000 {
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 60s
			write_timeout 60s
		}
		header_up X-Real-IP {remote_host}
	}
}

# Голый HTTP на 80 отдаём редиректом на https (auto_https-редиректы отключены,
# поэтому пишем явно), чтобы прямые заходы по http не висели.
http://{$SITE_DOMAIN} {
	redir https://{host}{uri} permanent
}

http://{$ANALYTICS_DOMAIN} {
	redir https://{host}{uri} permanent
}
