# throw.dog — пример конфигурации.
# Скопируй в .env (`cp .env.example .env`) и подставь реальные значения.
# Настоящий .env в git не попадает (см. .gitignore) и живёт на сервере.
#
# ВАЖНО про область видимости переменных (безопасность):
# .env авто-загружается docker compose для подстановки ${VAR} во ВСЕ сервисы.
# Но в контейнер `app` (смотрит в интернет) попадают ТОЛЬКО его переменные —
# см. явный `environment:` в docker-compose.yml. Секреты Umami
# (UMAMI_DB_PASSWORD, UMAMI_APP_SECRET) в app НЕ прокидываются: их читают
# только сервисы umami / umami_db. При компрометации app секреты БД не утекут.
#
# Ниже переменные сгруппированы по потребителю: [app], [umami], [caddy],
# [deploy]. Группа — это документация; физически всё лежит в одном .env.

# --- Домен и сеть -----------------------------------------------------------

# Домен, который обслуживает Caddy. Должен совпадать с CN/SAN
# сертификата Cloudflare Origin CA.
SITE_DOMAIN=throw.dog

# Внутренний порт приложения. Наружу НЕ публикуется:
# ходит только Caddy по внутренней docker-сети.
APP_PORT=8000

# Внешние порты Caddy на хосте. 80 нужен для редиректа на https.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- Поведение броска -------------------------------------------------------

# Сколько секунд живёт брошенный текст до самоуничтожения.
THROW_TTL_SECONDS=600

# Максимальный размер полезной нагрузки в байтах. Это ВИДИМЫЙ предел, одинаковый
# в обоих режимах броска. Закрытый бросок приезжает зашифрованным и на треть
# больше — эту разницу сервер добавляет себе сам, чтобы человек не узнавал о
# base64 из сообщения об ошибке.
THROW_MAX_BYTES=65536

# Искусственная задержка ответа при промахе (мс) — против перебора кодов.
THROW_MISS_DELAY_MS=1000

# --- Аналитика (self-hosted Umami, без cookies) -----------------------------

# Поддомен, на котором Caddy отдаёт Umami (боевой или временный sslip.io).
# Должен быть покрыт сертификатом (Origin CA *.throw.dog или ACME).
ANALYTICS_DOMAIN=analytics.throw.dog

# Хост, с которого страница грузит трекер Umami (обычно = ANALYTICS_DOMAIN).
# Читается приложением при рендере страниц. Пусто = аналитика отключена.
ANALYTICS_HOST=analytics.throw.dog

# ID сайта из панели Umami (Settings → Websites). Плейсхолдер до первого
# запуска; подставь реальный UUID и передеплой приложение.
ANALYTICS_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# [umami] Секрет подписи Umami. ОБЯЗАТЕЛЬНО задать длинное случайное значение,
# например: openssl rand -hex 32. В app НЕ прокидывается.
UMAMI_APP_SECRET=change-me-long-random-secret

# [umami] Креды Postgres под Umami. Пароль ОБЯЗАТЕЛЕН; имя/юзер по умолчанию
# umami. Пароль в app НЕ прокидывается — только в umami / umami_db.
UMAMI_DB_NAME=umami
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=change-me-strong-db-password

# --- ⚠ Операционные риски (см. DEPLOY.md, раздел «Безопасность») -------------
#
# 1. Umami поставляется с ДЕФОЛТНЫМ логином admin / umami, а дашборд открыт
#    наружу через Caddy на ANALYTICS_DOMAIN. СМЕНИ пароль при первом входе.
# 2. Боевой Caddyfile отдаёт ANALYTICS_DOMAIN тем же сертификатом Origin CA,
#    что и корневой домен, — это работает ТОЛЬКО если Origin-сертификат
#    покрывает поддомен (SAN содержит *.throw.dog или analytics.throw.dog).
#    Иначе Cloudflare Full (strict) вернёт 526 на поддомене.
# Подробности и что делать — в DEPLOY.md.

# --- Деплой (используется deploy.sh с ноутбука) -----------------------------

# Алиас хоста из ~/.ssh/config (или user@ip).
DEPLOY_HOST=throwdog

# Каталог проекта на VPS.
DEPLOY_DIR=/opt/throwdog

# Какой конфиг Caddy монтировать.
#   ./Caddyfile       — боевой: домен за Cloudflare, сертификат Origin CA
#   ./Caddyfile.acme  — промежуточный: домена ещё нет, ходим по временному
#                       имени (например 94.241.172.33.sslip.io) с настоящим
#                       сертификатом Let's Encrypt. Требует открытого порта 80.
CADDYFILE=./Caddyfile
